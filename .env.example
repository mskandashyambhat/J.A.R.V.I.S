# JARVIS Environment Configuration Template
# Copy this file to .env and fill in your API keys and configuration

# =============================================================================
# API KEYS (All Optional - JARVIS works without them but with limited features)
# =============================================================================

# News API (for news headlines)
# Get your free API key from: https://newsapi.org/
# NEWS_API_KEY=your_news_api_key_here

# OpenWeather API (for weather information)
# Get your free API key from: https://openweathermap.org/api
# OPENWEATHER_API_KEY=your_weather_api_key_here

# =============================================================================
# JARVIS CONFIGURATION
# =============================================================================

# Enable/disable features (true/false)
ENABLE_FACE_RECOGNITION=false
ENABLE_NEWS=false
ENABLE_WEATHER=false
ENABLE_EMAIL=false

# Voice settings
# VOICE_RATE=150
# VOICE_VOLUME=0.9

# Security settings
# LOG_LEVEL=INFO
# MAX_FAILED_AUTH_ATTEMPTS=3

# =============================================================================
# PRIVACY SETTINGS
# =============================================================================

# Data storage location (defaults to ~/.jarvis if not set)
# JARVIS_DATA_DIR=/path/to/your/data/directory

# Enable/disable logging of user interactions
# LOG_USER_ACTIVITY=true

# =============================================================================
# FEATURE-SPECIFIC SETTINGS
# =============================================================================

# Face Recognition
# FACE_RECOGNITION_THRESHOLD=50
# MAX_FACE_SAMPLES=30

# Email
# DEFAULT_EMAIL_PROVIDER=gmail

# News
# DEFAULT_NEWS_COUNTRY=us
# DEFAULT_NEWS_CATEGORY=general
# MAX_NEWS_HEADLINES=5

# =============================================================================
# NOTES
# =============================================================================

# 1. This file should never be committed to version control
# 2. Keep your API keys secure and don't share them
# 3. All settings are optional - JARVIS works with defaults
# 4. Settings marked as 'false' mean the feature is disabled
# 5. Remove the # symbol to activate a setting